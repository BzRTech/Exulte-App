#include <winver.h>
1 ICON "deixa.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "Deixa"
      VALUE "FileDescription", "Deixa - Mesa de audio para espetaculos"
      VALUE "FileVersion", "2.1.0"
      VALUE "InternalName", "Exulte"
      VALUE "OriginalFilename", "Exulte.exe"
      VALUE "ProductName", "Deixa"
      VALUE "ProductVersion", "2.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
